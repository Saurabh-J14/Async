<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Checkbox for Task status -->
        <CheckBox
            android:id="@+id/cbTaskStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@null"
            android:buttonTint="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Task Title -->
        <TextView
            android:id="@+id/txtTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Design Login Screen UI"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/txtTaskPriority"
            app:layout_constraintStart_toEndOf="@id/cbTaskStatus"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Task Description -->
        <TextView
            android:id="@+id/txtTaskDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Create high-fidelity mockups using Material Design tokens."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/txtTaskTitle"
            app:layout_constraintTop_toBottomOf="@id/txtTaskTitle" />

        <!-- Priority Badge -->
        <TextView
            android:id="@+id/txtTaskPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_high"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="HIGH"
            android:textColor="@color/priority_high_txt"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Task Category Tag and Due Date -->
        <TextView
            android:id="@+id/txtTaskCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_low"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="UI Design"
            android:textColor="@color/priority_low_txt"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/txtTaskTitle"
            app:layout_constraintTop_toBottomOf="@id/txtTaskDescription" />

        <TextView
            android:id="@+id/txtTaskDueDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Today"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/txtTaskCategory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtTaskCategory" />

        <!-- Assigned Date and Completed Date (Calendar Times) -->
        <TextView
            android:id="@+id/txtTaskCalendarDates"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Assigned: May 20, 2026 | Completed: Pending"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="italic"
            app:layout_constraintStart_toStartOf="@id/txtTaskTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTaskCategory" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
