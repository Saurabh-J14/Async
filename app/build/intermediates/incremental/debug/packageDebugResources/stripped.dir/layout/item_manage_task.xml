<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:background="@drawable/bg_edittext"
    android:layout_marginVertical="4dp"
    android:paddingHorizontal="12dp">

    <!-- Task details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_manage_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Design Login Screen UI"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <!-- Priority pill -->
            <TextView
                android:id="@+id/txt_manage_task_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/priority_high_bg"
                android:textColor="@color/priority_high_txt"
                android:text="HIGH"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"/>

            <!-- Workspace marker -->
            <TextView
                android:id="@+id/txt_manage_task_workspace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:text="IT Dept"
                android:textSize="11sp"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <!-- Assigned Date and Completed Date (Calendar Times) -->
        <TextView
            android:id="@+id/txt_manage_task_dates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Assigned: May 20, 2026 | Completed: Pending"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Status badge and Approval button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status badge -->
        <TextView
            android:id="@+id/txt_manage_task_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REVIEW"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_notification_badge"
            android:backgroundTint="@color/error_red"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:gravity="center"
            android:layout_marginRight="8dp"/>

        <!-- Approve action button -->
        <Button
            android:id="@+id/btn_manage_task_approve"
            android:layout_width="84dp"
            android:layout_height="36dp"
            android:backgroundTint="@color/success_green"
            android:text="Approve"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="visible"/>
    </LinearLayout>
</LinearLayout>
